  "LegalPage.1": {
    "group": "LegalPage",
    "text": "verwerkt de gegevens die je via deze website aan ons geeft."
  },
  "LegalPage.2": {
    "group": "LegalPage",
    "text": "Afspraak en contact"
  },
  "LegalPage.3": {
    "group": "LegalPage",
    "text": "Voor een afspraak vragen we om je naam, e-mailadres en telefoonnummer. Deze gegevens worden gebruikt om je afspraak te maken en te bevestigen. Een contactbericht bevat de gegevens die je zelf invult; het wordt per e-mail bij de salon afgeleverd."
  },
  "LegalPage.4": {
    "group": "LegalPage",
    "text": "Aanmeldingen"
  },
  "LegalPage.5": {
    "group": "LegalPage",
    "text": "Als je je aanmeldt voor de nieuwsbrief of jubileumactie gebruiken we je opgegeven contactgegevens voor die aanmelding. Je kunt je toestemming intrekken door ons te mailen."
  },
  "LegalPage.6": {
    "group": "LegalPage",
    "text": "Diensten achter deze site"
  },
  "LegalPage.7": {
    "group": "LegalPage",
    "text": "De website gebruikt Vercel voor hosting en bezoekersstatistieken, Supabase voor het CMS, onze online agenda voor afspraken en een e-maildienst voor formulierberichten. De kaart van Google wordt pas geladen als je daar zelf voor kiest."
  },
  "LegalPage.8": {
    "group": "LegalPage",
    "text": "Vragen over je gegevens"
  },
  "LegalPage.9": {
    "group": "LegalPage",
    "text": "Wil je je gegevens inzien, laten corrigeren of laten verwijderen? Mail"
  },
  "LegalPage.10": {
    "group": "LegalPage",
    "text": ". Deel alleen gegevens die nodig zijn voor je vraag."
  },
  "LegalPage.11": {
    "group": "LegalPage",
    "text": "De site bewaart lokaal je weergavevoorkeur, de laatst geladen publieke inhoud en of je de jubileumpopup hebt gesloten. CMS-login bewaart daarnaast een sessie op jouw apparaat."
  },
  "LegalPage.12": {
    "group": "LegalPage",
    "text": "Vercel Web Analytics wordt gebruikt voor bezoekersstatistieken. De Google-kaart maakt pas verbinding met Google nadat je op ‘Kaart laden’ hebt gedrukt. Via links naar Instagram gelden de instellingen van die dienst."
  },
  "LegalPage.13": {
    "group": "LegalPage",
    "text": "Je kunt lokale websitegegevens verwijderen via de privacy-instellingen van je browser. Je hoeft de kaart niet te laden om een afspraak te maken."
  },
