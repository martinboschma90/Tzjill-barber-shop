# Public origin used for canonical, robots, sitemap and Open Graph.
# Until tzjill.nl points at THIS app, keep the Vercel preview (or leave unset).
# Do NOT set this to www.notype-mgmt.com or the old WordPress www.tzjill.nl.
VITE_PUBLIC_SITE_URL=https://tzjill-barber-shop.vercel.app

# Required to unlock /cms. Without both keys the dashboard stays closed.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only (Vercel). Needed for CMS user admin, live/speed checks, mail.
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=
# BOOKING_FROM_EMAIL=
# RESEND_API_KEY=
# PAGESPEED_API_KEY=

# Server-only. Optional override for Salonhub create/verify.
# The public booking reads do not use this. Leave empty unless Salonhub
# gave you an admin key that their OnlineAppointment API accepts.
# Never prefix with VITE_.
# SALONHUB_API_KEY=
