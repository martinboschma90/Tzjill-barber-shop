{
  "crons": [
    {
      "path": "/api/site-speed",
      "schedule": "0 6 1,15 * *"
    }
  ],
  "functions": {
    "api/site-live.js": {
      "maxDuration": 30
    },
    "api/site-speed.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "inspiration" }],
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "query", "key": "inspiration" }],
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "slide" }],
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "query", "key": "slide" }],
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "barbershop" }],
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "query", "key": "barbershop" }],
      "destination": "/",
      "statusCode": 301
    },
    { "source": "/treatment/haircut", "destination": "/prijzen", "statusCode": 301 },
    { "source": "/treatment/haircut/", "destination": "/prijzen", "statusCode": 301 },
    { "source": "/treatment/haircut-wassen", "destination": "/prijzen", "statusCode": 301 },
    { "source": "/treatment/haircut-wassen/", "destination": "/prijzen", "statusCode": 301 },
    { "source": "/treatment/haircut-baard-trimmen", "destination": "/prijzen", "statusCode": 301 },
    { "source": "/treatment/haircut-baard-trimmen/", "destination": "/prijzen", "statusCode": 301 },
    { "source": "/treatment/relaxen-ontkroezen", "destination": "/prijzen", "statusCode": 301 },
    { "source": "/treatment/relaxen-ontkroezen/", "destination": "/prijzen", "statusCode": 301 },
    { "source": "/treatment/junior-barber", "destination": "/prijzen#kinderen", "statusCode": 301 },
    { "source": "/treatment/junior-barber/", "destination": "/prijzen#kinderen", "statusCode": 301 },
    { "source": "/treatment/1-stand-scheren", "destination": "/baard-scheren", "statusCode": 301 },
    { "source": "/treatment/1-stand-scheren/", "destination": "/baard-scheren", "statusCode": 301 },
    { "source": "/treatment/1-stand-scheren-baard-trimmen", "destination": "/baard-scheren", "statusCode": 301 },
    { "source": "/treatment/1-stand-scheren-baard-trimmen/", "destination": "/baard-scheren", "statusCode": 301 },
    { "source": "/treatment/contouren", "destination": "/baard-scheren", "statusCode": 301 },
    { "source": "/treatment/contouren/", "destination": "/baard-scheren", "statusCode": 301 },
    { "source": "/treatment/baard-alleen-lijnen", "destination": "/baard-scheren", "statusCode": 301 },
    { "source": "/treatment/baard-alleen-lijnen/", "destination": "/baard-scheren", "statusCode": 301 },
    { "source": "/treatment/baard-trimmen", "destination": "/baard-scheren", "statusCode": 301 },
    { "source": "/treatment/baard-trimmen/", "destination": "/baard-scheren", "statusCode": 301 },
    { "source": "/treatment", "destination": "/prijzen", "statusCode": 301 },
    { "source": "/treatment/", "destination": "/prijzen", "statusCode": 301 },
    { "source": "/treatment/:slug", "destination": "/prijzen", "statusCode": 301 },
    { "source": "/treatment/:slug/", "destination": "/prijzen", "statusCode": 301 },
    { "source": "/product", "destination": "/", "statusCode": 301 },
    { "source": "/product/", "destination": "/", "statusCode": 301 },
    { "source": "/product/:slug", "destination": "/", "statusCode": 301 },
    { "source": "/product/:slug/", "destination": "/", "statusCode": 301 },
    { "source": "/product/:slug*", "destination": "/", "statusCode": 301 },
    { "source": "/trnds", "destination": "/lookbook", "statusCode": 301 },
    { "source": "/trnds/", "destination": "/lookbook", "statusCode": 301 },
    { "source": "/trnds/:slug", "destination": "/lookbook", "statusCode": 301 },
    { "source": "/trnds/:slug/", "destination": "/lookbook", "statusCode": 301 },
    { "source": "/trnds/:slug*", "destination": "/lookbook", "statusCode": 301 },
    { "source": "/tta", "destination": "/lookbook", "statusCode": 301 },
    { "source": "/tta/", "destination": "/lookbook", "statusCode": 301 },
    { "source": "/tta/:slug", "destination": "/lookbook", "statusCode": 301 },
    { "source": "/tta/:slug/", "destination": "/lookbook", "statusCode": 301 },
    { "source": "/tta/:slug*", "destination": "/lookbook", "statusCode": 301 },
    { "source": "/producten", "destination": "/", "statusCode": 301 },
    { "source": "/producten/", "destination": "/", "statusCode": 301 },
    { "source": "/privacy", "destination": "/contact", "statusCode": 301 },
    { "source": "/privacy/", "destination": "/contact", "statusCode": 301 },
    { "source": "/cookiebeleid-eu", "destination": "/contact", "statusCode": 301 },
    { "source": "/cookiebeleid-eu/", "destination": "/contact", "statusCode": 301 },
    { "source": "/inspiratie", "destination": "/lookbook", "statusCode": 301 },
    { "source": "/inspiratie/", "destination": "/lookbook", "statusCode": 301 },
    { "source": "/over-barber-select-society", "destination": "/over-ons", "statusCode": 301 },
    { "source": "/over-barber-select-society/", "destination": "/over-ons", "statusCode": 301 },
    { "source": "/trends", "destination": "/lookbook", "statusCode": 301 },
    { "source": "/trends/", "destination": "/lookbook", "statusCode": 301 },
    { "source": "/tips-tricks-en-acties", "destination": "/lookbook", "statusCode": 301 },
    { "source": "/tips-tricks-en-acties/", "destination": "/lookbook", "statusCode": 301 },
    { "source": "/voorbeeld-pagina", "destination": "/", "statusCode": 301 },
    { "source": "/voorbeeld-pagina/", "destination": "/", "statusCode": 301 },
    { "source": "/103-2", "destination": "/", "statusCode": 301 },
    { "source": "/103-2/", "destination": "/", "statusCode": 301 },
    { "source": "/over-ons/", "destination": "/over-ons", "statusCode": 301 },
    { "source": "/contact/", "destination": "/contact", "statusCode": 301 },
    { "source": "/prijzen/", "destination": "/prijzen", "statusCode": 301 },
    { "source": "/lookbook/", "destination": "/lookbook", "statusCode": 301 },
    { "source": "/collabs/", "destination": "/collabs", "statusCode": 301 },
    { "source": "/team/", "destination": "/team", "statusCode": 301 },
    { "source": "/booking/", "destination": "/booking", "statusCode": 301 },
    { "source": "/faq/", "destination": "/faq", "statusCode": 301 },
    { "source": "/barbershop-leeuwarden/", "destination": "/barbershop-leeuwarden", "statusCode": 301 },
    { "source": "/baard-scheren/", "destination": "/baard-scheren", "statusCode": 301 },
    { "source": "/herenkapper-leeuwarden", "destination": "/barbershop-leeuwarden", "statusCode": 301 },
    { "source": "/herenkapper-leeuwarden/", "destination": "/barbershop-leeuwarden", "statusCode": 301 },
    { "source": "/baard", "destination": "/baard-scheren", "statusCode": 301 },
    { "source": "/baard/", "destination": "/baard-scheren", "statusCode": 301 }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/promo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icons.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!assets/|brand/|promo/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
